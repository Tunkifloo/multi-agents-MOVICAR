# Copiar a .env (no se sube a git). Claude Code no puede leer .env (permissions.deny).

# Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelos Gemini. En el plan gratuito cada modelo tiene su propia cuota por minuto:
# el orquestador y los subagentes usan modelos distintos y, si uno se satura, se pasa al de respaldo.
MODELO_ORQUESTADOR=gemini-3.5-flash-lite
MODELO_SUBAGENTES=gemini-3.1-flash-lite
MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
# Cuotas por minuto medidas en el plan gratuito (dejar un margen de 1)
LIMITES_RPM=gemini-3.5-flash=5,gemini-3.5-flash-lite=14,gemini-3.1-flash-lite=14

# Personal del taller (panel del jefe y back-office, Basic Auth)
JEFE_USUARIO=jefe
JEFE_CLAVE=

# Utilidad de pruebas (POST /api/pruebas con cabecera X-Test-Token). Poner false antes de la demostración.
MODO_PRUEBAS=true
TEST_TOKEN=

# PostgreSQL (docker compose)
POSTGRES_PASSWORD=

# Puerto de la interfaz web en el host
WEB_PORT=8088
# Scripts de prueba (Docker: interfaz; local sin Docker: http://localhost:8000/api)
MOVICAR_API_URL=http://localhost:8088/api

# LangSmith (opcional): trazas de cada agente, herramienta y llamada al modelo
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=movicar
