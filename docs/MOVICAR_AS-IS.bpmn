<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_Proceso_ASIS" targetNamespace="http://upao.edu.pe/isia/movicar" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:dataStore id="Store_WhatsApp" name="WhatsApp Business (historial de chats)" />
  <bpmn:dataStore id="Store_Pizarra" name="Pizarra física de turnos" />
  <bpmn:dataStore id="Store_Calendar" name="Google Calendar de Recepción" />
  <bpmn:dataStore id="Store_Inventario" name="Inventario de almacén (cuaderno)" />
  <bpmn:collaboration id="Collab_Proceso_ASIS">
    <bpmn:participant id="Part_Movicar" name="MOVICAR Taller Mecánico · estado actual (AS-IS)" processRef="Proceso_ASIS" />
    <bpmn:participant id="Part_Cliente" name="Cliente (propietario del vehículo)" />
    <bpmn:participant id="Part_Proveedor" name="Proveedor externo de repuestos" />
    <bpmn:messageFlow id="Msg_Part_Cliente_S1" sourceRef="Part_Cliente" targetRef="S1" />
    <bpmn:messageFlow id="Msg_A1_Part_Cliente" sourceRef="A1" targetRef="Part_Cliente" />
    <bpmn:messageFlow id="Msg_Part_Cliente_M1" sourceRef="Part_Cliente" targetRef="M1" />
    <bpmn:messageFlow id="Msg_A9_Part_Cliente" sourceRef="A9" targetRef="Part_Cliente" />
    <bpmn:messageFlow id="Msg_Part_Cliente_M2" sourceRef="Part_Cliente" targetRef="M2" />
    <bpmn:messageFlow id="Msg_A12_Part_Cliente" sourceRef="A12" targetRef="Part_Cliente" />
    <bpmn:messageFlow id="Msg_A6_Part_Proveedor" sourceRef="A6" targetRef="Part_Proveedor" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_ASIS" name="Cotizar repuestos y mano de obra y agendar la cita (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Recepcion" name="Recepción / Administrador">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Jefe" name="Jefe de taller">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Almacen" name="Almacén de repuestos">
        <bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Solicitud de cotización recibida (WhatsApp / llamada)">
      <bpmn:outgoing>Flow_S1_T1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S1" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="T1" name="Espera de primera atención (recepción ocupada)">
      <bpmn:incoming>Flow_S1_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_G1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_T1"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G1" name="">
      <bpmn:incoming>Flow_T1_G1</bpmn:incoming>
      <bpmn:incoming>Flow_G3_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_A1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="A1" name="Solicitar datos del vehículo (placa, año, modelo, falla)">
      <bpmn:incoming>Flow_G1_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A1_G2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_A1_DS1"><bpmn:targetRef>DS1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="G2" name="¿Cliente responde?">
      <bpmn:incoming>Flow_A1_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_M1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_T2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M1" name="Datos del vehículo recibidos">
      <bpmn:incoming>Flow_G2_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_G3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_M1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="T2" name="Vencen 24 h sin respuesta">
      <bpmn:incoming>Flow_G2_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_E1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_T2"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E1" name="Cliente perdido (se va a otro taller)">
      <bpmn:incoming>Flow_T2_E1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G3" name="¿Datos completos?">
      <bpmn:incoming>Flow_M1_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_G1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_A2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A2" name="Clasificar la solicitud según la falla descrita">
      <bpmn:incoming>Flow_G3_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A2_G4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G4" name="¿Tipo de servicio?">
      <bpmn:incoming>Flow_A2_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_A3</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_T3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A3" name="Consultar el tarifario de mantenimiento">
      <bpmn:incoming>Flow_G4_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A3_G7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="T3" name="Espera de disponibilidad del jefe de taller">
      <bpmn:incoming>Flow_G4_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_A4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_T3"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="A4" name="Evaluar la falla y estimar repuestos y horas-hombre">
      <bpmn:incoming>Flow_T3_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A4_A5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A5" name="Verificar el stock de repuestos en almacén">
      <bpmn:incoming>Flow_A4_A5</bpmn:incoming>
      <bpmn:outgoing>Flow_A5_G5</bpmn:outgoing>
      <bpmn:property id="Prop_DA_A5_DS4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_A5_DS4"><bpmn:sourceRef>DS4</bpmn:sourceRef><bpmn:targetRef>Prop_DA_A5_DS4</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G5" name="¿Hay stock?">
      <bpmn:incoming>Flow_A5_G5</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_G6</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_A6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A6" name="Solicitar precio y plazo al proveedor (llamada)">
      <bpmn:incoming>Flow_G5_A6</bpmn:incoming>
      <bpmn:outgoing>Flow_A6_T4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="T4" name="Espera de respuesta del proveedor">
      <bpmn:incoming>Flow_A6_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_G6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_T4"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G6" name="">
      <bpmn:incoming>Flow_G5_G6</bpmn:incoming>
      <bpmn:incoming>Flow_T4_G6</bpmn:incoming>
      <bpmn:outgoing>Flow_G6_G7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G7" name="">
      <bpmn:incoming>Flow_G6_G7</bpmn:incoming>
      <bpmn:incoming>Flow_A3_G7</bpmn:incoming>
      <bpmn:outgoing>Flow_G7_A7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A7" name="Calcular la cotización (repuestos + mano de obra)">
      <bpmn:incoming>Flow_G7_A7</bpmn:incoming>
      <bpmn:outgoing>Flow_A7_G8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G8" name="">
      <bpmn:incoming>Flow_A7_G8</bpmn:incoming>
      <bpmn:incoming>Flow_M3_G8</bpmn:incoming>
      <bpmn:outgoing>Flow_G8_A8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A8" name="Revisar la pizarra de disponibilidad de mecánicos">
      <bpmn:incoming>Flow_G8_A8</bpmn:incoming>
      <bpmn:outgoing>Flow_A8_A9</bpmn:outgoing>
      <bpmn:property id="Prop_DA_A8_DS2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_A8_DS2"><bpmn:sourceRef>DS2</bpmn:sourceRef><bpmn:targetRef>Prop_DA_A8_DS2</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:sendTask id="A9" name="Redactar y enviar la cotización con turno propuesto">
      <bpmn:incoming>Flow_A8_A9</bpmn:incoming>
      <bpmn:outgoing>Flow_A9_G9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="G9" name="¿Qué responde el cliente?">
      <bpmn:incoming>Flow_A9_G9</bpmn:incoming>
      <bpmn:outgoing>Flow_G9_M2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G9_T5</bpmn:outgoing>
      <bpmn:outgoing>Flow_G9_M3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M2" name="Cliente acepta el turno">
      <bpmn:incoming>Flow_G9_M2</bpmn:incoming>
      <bpmn:outgoing>Flow_M2_A10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_M2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="T5" name="Vencen 48 h sin respuesta">
      <bpmn:incoming>Flow_G9_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5_E3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_T5"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E3" name="Cotización sin respuesta (cliente no concreta)">
      <bpmn:incoming>Flow_T5_E3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="M3" name="Cliente pide otra fecha">
      <bpmn:incoming>Flow_G9_M3</bpmn:incoming>
      <bpmn:outgoing>Flow_M3_G8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_M3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="A10" name="Registrar la cita en Google Calendar">
      <bpmn:incoming>Flow_M2_A10</bpmn:incoming>
      <bpmn:outgoing>Flow_A10_A11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_A10_DS3"><bpmn:targetRef>DS3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="A11" name="Anotar la cita en la pizarra física">
      <bpmn:incoming>Flow_A10_A11</bpmn:incoming>
      <bpmn:outgoing>Flow_A11_A12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_A11_DS2b"><bpmn:targetRef>DS2b</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sendTask id="A12" name="Confirmar la cita al cliente">
      <bpmn:incoming>Flow_A11_A12</bpmn:incoming>
      <bpmn:outgoing>Flow_A12_E2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E2" name="Cotización enviada y cita reservada">
      <bpmn:incoming>Flow_A12_E2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS1" name="WhatsApp Business (historial de chats)" dataStoreRef="Store_WhatsApp" />
    <bpmn:dataStoreReference id="DS2" name="Pizarra física de turnos" dataStoreRef="Store_Pizarra" />
    <bpmn:dataStoreReference id="DS2b" name="Pizarra física de turnos" dataStoreRef="Store_Pizarra" />
    <bpmn:dataStoreReference id="DS3" name="Google Calendar de Recepción" dataStoreRef="Store_Calendar" />
    <bpmn:dataStoreReference id="DS4" name="Inventario de almacén (cuaderno)" dataStoreRef="Store_Inventario" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Demora en responder: recepción atiende pagos en el local. Principal causa de clientes perdidos.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>LÍNEA BASE (15 casos consecutivos, 01–15/09/2026): tiempo de ciclo mediana 4 h · máx. 26 h | trabajo efectivo 18,2 min | eficiencia del ciclo 7,6 % | reproceso 26,7 % | ~30 casos/mes</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N3"><bpmn:text>Doble registro manual WhatsApp → Calendar → pizarra: errores al tipear placas (dolor principal).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N4"><bpmn:text>El jefe reprograma la agenda cuando la cita se registró con información incompleta.</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_S1_T1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_G1" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_A1" sourceRef="G1" targetRef="A1" />
    <bpmn:sequenceFlow id="Flow_A1_G2" sourceRef="A1" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_M1" sourceRef="G2" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_G2_T2" sourceRef="G2" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_T2_E1" sourceRef="T2" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_M1_G3" sourceRef="M1" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_G3_G1" name="No (falta km, año o tarjeta) → reproceso" sourceRef="G3" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G3_A2" name="Sí" sourceRef="G3" targetRef="A2" />
    <bpmn:sequenceFlow id="Flow_A2_G4" sourceRef="A2" targetRef="G4" />
    <bpmn:sequenceFlow id="Flow_G4_A3" name="Preventivo" sourceRef="G4" targetRef="A3" />
    <bpmn:sequenceFlow id="Flow_G4_T3" name="Correctivo" sourceRef="G4" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_T3_A4" sourceRef="T3" targetRef="A4" />
    <bpmn:sequenceFlow id="Flow_A4_A5" sourceRef="A4" targetRef="A5" />
    <bpmn:sequenceFlow id="Flow_A5_G5" sourceRef="A5" targetRef="G5" />
    <bpmn:sequenceFlow id="Flow_G5_G6" name="Sí" sourceRef="G5" targetRef="G6" />
    <bpmn:sequenceFlow id="Flow_G5_A6" name="No (≈20 % de casos)" sourceRef="G5" targetRef="A6" />
    <bpmn:sequenceFlow id="Flow_A6_T4" sourceRef="A6" targetRef="T4" />
    <bpmn:sequenceFlow id="Flow_T4_G6" sourceRef="T4" targetRef="G6" />
    <bpmn:sequenceFlow id="Flow_G6_G7" sourceRef="G6" targetRef="G7" />
    <bpmn:sequenceFlow id="Flow_A3_G7" sourceRef="A3" targetRef="G7" />
    <bpmn:sequenceFlow id="Flow_G7_A7" sourceRef="G7" targetRef="A7" />
    <bpmn:sequenceFlow id="Flow_A7_G8" sourceRef="A7" targetRef="G8" />
    <bpmn:sequenceFlow id="Flow_G8_A8" sourceRef="G8" targetRef="A8" />
    <bpmn:sequenceFlow id="Flow_A8_A9" sourceRef="A8" targetRef="A9" />
    <bpmn:sequenceFlow id="Flow_A9_G9" sourceRef="A9" targetRef="G9" />
    <bpmn:sequenceFlow id="Flow_G9_M2" sourceRef="G9" targetRef="M2" />
    <bpmn:sequenceFlow id="Flow_G9_T5" sourceRef="G9" targetRef="T5" />
    <bpmn:sequenceFlow id="Flow_G9_M3" sourceRef="G9" targetRef="M3" />
    <bpmn:sequenceFlow id="Flow_T5_E3" sourceRef="T5" targetRef="E3" />
    <bpmn:sequenceFlow id="Flow_M3_G8" sourceRef="M3" targetRef="G8" />
    <bpmn:sequenceFlow id="Flow_M2_A10" sourceRef="M2" targetRef="A10" />
    <bpmn:sequenceFlow id="Flow_A10_A11" sourceRef="A10" targetRef="A11" />
    <bpmn:sequenceFlow id="Flow_A11_A12" sourceRef="A11" targetRef="A12" />
    <bpmn:sequenceFlow id="Flow_A12_E2" sourceRef="A12" targetRef="E2" />
    <bpmn:association id="Assoc_N1" sourceRef="T1" targetRef="N1" />
    <bpmn:association id="Assoc_N3" sourceRef="A11" targetRef="N3" />
    <bpmn:association id="Assoc_N4" sourceRef="A4" targetRef="N4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Proceso_ASIS">
    <bpmndi:BPMNPlane id="Plane_Proceso_ASIS" bpmnElement="Collab_Proceso_ASIS">
      <bpmndi:BPMNShape id="Part_Movicar_di" bpmnElement="Part_Movicar" isHorizontal="true"><dc:Bounds x="160" y="180" width="3480" height="940" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Recepcion_di" bpmnElement="Lane_Recepcion" isHorizontal="true"><dc:Bounds x="190" y="180" width="3450" height="500" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Jefe_di" bpmnElement="Lane_Jefe" isHorizontal="true"><dc:Bounds x="190" y="680" width="3450" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Almacen_di" bpmnElement="Lane_Almacen" isHorizontal="true"><dc:Bounds x="190" y="880" width="3450" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Cliente_di" bpmnElement="Part_Cliente" isHorizontal="true" color:background-color="#f8fafc" color:border-color="#334155"><dc:Bounds x="160" y="40" width="3480" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_Proveedor_di" bpmnElement="Part_Proveedor" isHorizontal="true" color:background-color="#f8fafc" color:border-color="#334155"><dc:Bounds x="160" y="1160" width="3480" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1" bioc:stroke="#15803d" bioc:fill="#dcfce7" color:background-color="#dcfce7" color:border-color="#15803d">
