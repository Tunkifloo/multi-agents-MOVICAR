<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_Proceso_TOBE" targetNamespace="http://upao.edu.pe/isia/movicar" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.0.0">
  <bpmn:error id="Error_Integracion" name="Fallo de integración" errorCode="INTEGRATION_FAILED" />
  <bpmn:dataStore id="Store_Idem" name="Tabla de idempotencia (n8n Data Table)" />
  <bpmn:dataStore id="Store_Cola" name="Cola de fallidos (Google Sheets)" />
  <bpmn:dataStore id="Store_Catalogo" name="Catálogo, stock y tarifario (Google Sheets)" />
  <bpmn:dataStore id="Store_Calendar" name="Google Calendar del taller" />
  <bpmn:collaboration id="Collab_Proceso_TOBE">
    <bpmn:participant id="Part_Movicar" name="MOVICAR Taller Mecánico · estado futuro (TO-BE) · flujo multiagente en n8n" processRef="Proceso_TOBE" />
    <bpmn:participant id="Part_Cliente" name="Cliente (propietario del vehículo) · WhatsApp" />
    <bpmn:messageFlow id="Msg_Part_Cliente_S1" sourceRef="Part_Cliente" targetRef="S1" />
    <bpmn:messageFlow id="Msg_A2_Part_Cliente" sourceRef="A2" targetRef="Part_Cliente" />
    <bpmn:messageFlow id="Msg_D1_Part_Cliente" sourceRef="D1" targetRef="Part_Cliente" />
    <bpmn:messageFlow id="Msg_A4_Part_Cliente" sourceRef="A4" targetRef="Part_Cliente" />
    <bpmn:messageFlow id="Msg_R1_Part_Cliente" sourceRef="R1" targetRef="Part_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_TOBE" name="Cotizar repuestos y mano de obra y agendar la cita (TO-BE multiagente n8n)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Orq" name="Orquestador n8n (flujo determinista)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T48</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recep" name="Agente Recepcionista IA">
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Humano" name="Humano en el bucle (Jefe de taller / Recepción)">
        <bpmn:flowNodeRef>H1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cotiz" name="Agente Cotizador IA">
        <bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agenda" name="Agente de Agenda IA">
        <bpmn:flowNodeRef>AG1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AG2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AG4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AG3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Mensaje de WhatsApp recibido (webhook)">
      <bpmn:outgoing>Flow_S1_T1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Normalizar el mensaje (teléfono E.164, texto)">
      <bpmn:incoming>Flow_S1_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_G0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G0" name="">
      <bpmn:incoming>Flow_T1_G0</bpmn:incoming>
      <bpmn:incoming>Flow_M1_G0</bpmn:incoming>
      <bpmn:outgoing>Flow_G0_A1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="A1" name="Extraer datos del vehículo y de la falla (LLM)">
      <bpmn:incoming>Flow_G0_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A1_T2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T2" name="Validar contra el contrato de entrada">
      <bpmn:incoming>Flow_A1_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2_G1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="¿Cumple el contrato?">
      <bpmn:incoming>Flow_T2_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_A2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_T3b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="A2" name="Pedir al cliente solo los datos faltantes">
      <bpmn:incoming>Flow_G1_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A2_G2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="G2" name="">
      <bpmn:incoming>Flow_A2_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_M1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_T3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M1" name="Respuesta del cliente">
      <bpmn:incoming>Flow_G2_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M1_G0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_M1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="T3" name="Vencen 24 h sin respuesta">
      <bpmn:incoming>Flow_G2_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_E1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_T3"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="E1" name="Solicitud cerrada por datos incompletos">
      <bpmn:incoming>Flow_T3_E1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T3b" name="Calcular la clave de idempotencia">
      <bpmn:incoming>Flow_G1_T3b</bpmn:incoming>
      <bpmn:outgoing>Flow_T3b_G3</bpmn:outgoing>
      <bpmn:property id="Prop_DA_T3b_DS1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_T3b_DS1"><bpmn:sourceRef>DS1</bpmn:sourceRef><bpmn:targetRef>Prop_DA_T3b_DS1</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="¿Clave ya registrada?">
      <bpmn:incoming>Flow_T3b_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_D1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_A3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="D1" name="Reenviar la cita existente al cliente">
      <bpmn:incoming>Flow_G3_D1</bpmn:incoming>
      <bpmn:outgoing>Flow_D1_E2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E2" name="Duplicado: sin nuevo registro">
      <bpmn:incoming>Flow_D1_E2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="A3" name="Clasificar el servicio y estimar la confianza (LLM)">
      <bpmn:incoming>Flow_G3_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A3_G4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="¿Preventivo y confianza ≥ 0,90?">
      <bpmn:incoming>Flow_A3_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_H1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_G5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="H1" name="Validar diagnóstico y prioridad (Jefe de taller)">
      <bpmn:incoming>Flow_G4_H1</bpmn:incoming>
      <bpmn:outgoing>Flow_H1_G5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G5" name="">
      <bpmn:incoming>Flow_H1_G5</bpmn:incoming>
      <bpmn:incoming>Flow_G4_G5</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_G6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="G6" name="">
      <bpmn:incoming>Flow_G5_G6</bpmn:incoming>
      <bpmn:outgoing>Flow_G6_C1</bpmn:outgoing>
      <bpmn:outgoing>Flow_G6_AG1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="C1" name="Consultar stock y precios de repuestos">
      <bpmn:incoming>Flow_G6_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C1_C2</bpmn:outgoing>
      <bpmn:property id="Prop_DA_C1_DS3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_C1_DS3"><bpmn:sourceRef>DS3</bpmn:sourceRef><bpmn:targetRef>Prop_DA_C1_DS3</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="C2" name="Calcular la mano de obra según tarifario">
      <bpmn:incoming>Flow_C1_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C2_G7</bpmn:outgoing>
      <bpmn:property id="Prop_DA_C2_DS3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_C2_DS3"><bpmn:sourceRef>DS3</bpmn:sourceRef><bpmn:targetRef>Prop_DA_C2_DS3</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G7" name="¿Repuestos en stock?">
      <bpmn:incoming>Flow_C2_G7</bpmn:incoming>
      <bpmn:outgoing>Flow_G7_H2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G7_G8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="H2" name="Confirmar precio y plazo con el proveedor (Recepción)">
      <bpmn:incoming>Flow_G7_H2</bpmn:incoming>
      <bpmn:outgoing>Flow_H2_G8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G8" name="">
      <bpmn:incoming>Flow_H2_G8</bpmn:incoming>
      <bpmn:incoming>Flow_G7_G8</bpmn:incoming>
      <bpmn:outgoing>Flow_G8_C3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C3" name="Generar la cotización detallada">
      <bpmn:incoming>Flow_G8_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C3_G9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AG1" name="Consultar la disponibilidad de mecánicos">
      <bpmn:incoming>Flow_G6_AG1</bpmn:incoming>
      <bpmn:outgoing>Flow_AG1_AG2</bpmn:outgoing>
      <bpmn:property id="Prop_DA_AG1_DS4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_AG1_DS4"><bpmn:sourceRef>DS4</bpmn:sourceRef><bpmn:targetRef>Prop_DA_AG1_DS4</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AG2" name="Proponer tres turnos según tipo y prioridad">
      <bpmn:incoming>Flow_AG1_AG2</bpmn:incoming>
      <bpmn:outgoing>Flow_AG2_G9</bpmn:outgoing>
      <bpmn:property id="Prop_DA_AG2_DS4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_AG2_DS4"><bpmn:sourceRef>DS4</bpmn:sourceRef><bpmn:targetRef>Prop_DA_AG2_DS4</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="G9" name="">
      <bpmn:incoming>Flow_C3_G9</bpmn:incoming>
      <bpmn:incoming>Flow_AG2_G9</bpmn:incoming>
      <bpmn:outgoing>Flow_G9_G11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G11" name="">
      <bpmn:incoming>Flow_G9_G11</bpmn:incoming>
      <bpmn:incoming>Flow_AG4_G11</bpmn:incoming>
      <bpmn:outgoing>Flow_G11_A4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="A4" name="Enviar la cotización y los turnos propuestos">
      <bpmn:incoming>Flow_G11_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A4_G10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="G10" name="¿Qué responde el cliente?">
      <bpmn:incoming>Flow_A4_G10</bpmn:incoming>
      <bpmn:outgoing>Flow_G10_M2</bpmn:outgoing>
      <bpmn:outgoing>Flow_G10_M3</bpmn:outgoing>
      <bpmn:outgoing>Flow_G10_T48</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M2" name="Cliente elige turno">
      <bpmn:incoming>Flow_G10_M2</bpmn:incoming>
      <bpmn:outgoing>Flow_M2_AG3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_M2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="M3" name="Cliente pide otra fecha">
      <bpmn:incoming>Flow_G10_M3</bpmn:incoming>
      <bpmn:outgoing>Flow_M3_AG4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_M3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="T48" name="Vencen 48 h sin respuesta">
      <bpmn:incoming>Flow_G10_T48</bpmn:incoming>
      <bpmn:outgoing>Flow_T48_R1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_T48"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="R1" name="Enviar recordatorio y registrar seguimiento">
      <bpmn:incoming>Flow_T48_R1</bpmn:incoming>
      <bpmn:outgoing>Flow_R1_E3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E3" name="Cotización sin confirmar (seguimiento)">
      <bpmn:incoming>Flow_R1_E3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="AG4" name="Proponer nuevos turnos disponibles">
      <bpmn:incoming>Flow_M3_AG4</bpmn:incoming>
      <bpmn:outgoing>Flow_AG4_G11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AG3" name="Crear el evento en Google Calendar y registrar la clave">
      <bpmn:incoming>Flow_M2_AG3</bpmn:incoming>
      <bpmn:outgoing>Flow_AG3_A5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_AG3_DS5"><bpmn:targetRef>DS5</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B1" name="Fallo de API tras 3 reintentos" attachedToRef="AG3">
      <bpmn:outgoing>Flow_B1_F1</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_B1" errorRef="Error_Integracion" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="F1" name="Registrar en la cola de fallidos (6 campos) y alertar">
      <bpmn:incoming>Flow_B1_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_F1_EE</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_F1_DS2"><bpmn:targetRef>DS2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EE" name="Fallo registrado para reproceso">
      <bpmn:incoming>Flow_F1_EE</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_EE" errorRef="Error_Integracion" />
    </bpmn:endEvent>
    <bpmn:sendTask id="A5" name="Confirmar la cita y los requisitos de ingreso">
      <bpmn:incoming>Flow_AG3_A5</bpmn:incoming>
      <bpmn:outgoing>Flow_A5_E4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E4" name="Cotización enviada y cita agendada">
      <bpmn:incoming>Flow_A5_E4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS1" name="Tabla de idempotencia (n8n Data Table)" dataStoreRef="Store_Idem" />
    <bpmn:dataStoreReference id="DS2" name="Cola de fallidos (Google Sheets)" dataStoreRef="Store_Cola" />
    <bpmn:dataStoreReference id="DS3" name="Catálogo, stock y tarifario (Google Sheets)" dataStoreRef="Store_Catalogo" />
    <bpmn:dataStoreReference id="DS4" name="Google Calendar del taller" dataStoreRef="Store_Calendar" />
    <bpmn:dataStoreReference id="DS5" name="Google Calendar del taller" dataStoreRef="Store_Calendar" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Cada “Agente IA” es un nodo AI Agent de n8n (LLM + memoria + herramientas). El orquestador valida, normaliza y calcula la clave ANTES de la primera acción externa.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2"><bpmn:text>Humano en el bucle (S02): solo casos correctivos o con confianza &lt; 0,90. Notificación inmediata; SLA de revisión 2 h.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N3"><bpmn:text>Metas TO-BE: primera respuesta &lt; 1 min · ciclo mediana 4 h → &lt; 15 min en preventivos · reproceso 26,7 % → &lt; 10 % · cero doble registro manual.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N4"><bpmn:text>Todas las acciones externas: reintento 3× con retroceso (5 s, 15 s, 45 s); al agotarse → cola de fallidos.</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_S1_T1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="Flow_T1_G0" sourceRef="T1" targetRef="G0" />
    <bpmn:sequenceFlow id="Flow_G0_A1" sourceRef="G0" targetRef="A1" />
    <bpmn:sequenceFlow id="Flow_A1_T2" sourceRef="A1" targetRef="T2" />
    <bpmn:sequenceFlow id="Flow_T2_G1" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_G1_A2" name="No" sourceRef="G1" targetRef="A2" />
    <bpmn:sequenceFlow id="Flow_A2_G2" sourceRef="A2" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_G2_M1" sourceRef="G2" targetRef="M1" />
    <bpmn:sequenceFlow id="Flow_M1_G0" sourceRef="M1" targetRef="G0" />
    <bpmn:sequenceFlow id="Flow_G2_T3" sourceRef="G2" targetRef="T3" />
    <bpmn:sequenceFlow id="Flow_T3_E1" sourceRef="T3" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_G1_T3b" name="Sí" sourceRef="G1" targetRef="T3b" />
    <bpmn:sequenceFlow id="Flow_T3b_G3" sourceRef="T3b" targetRef="G3" />
    <bpmn:sequenceFlow id="Flow_G3_D1" name="Sí" sourceRef="G3" targetRef="D1" />
    <bpmn:sequenceFlow id="Flow_D1_E2" sourceRef="D1" targetRef="E2" />
